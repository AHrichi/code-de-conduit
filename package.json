{
  "name": "driving-license-app",
  "version": "1.0.9",
  "description": "A driving license study application.",
  "author": {
    "name": "Ahmed Hrichi",
    "email": "ahmed.hrichi@example.com"
  },
  "homepage": "https://github.com/ahmed-hrichi/driving-license-app",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "wait-on tcp:4200 && cross-env SERVE_URL=http://localhost:4200 electron .",
    "electron:serve": "concurrently \"npm start\" \"npm run electron\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.ahmedhrichi.drivinglicense",
    "mac": {
      "icon": "public/app_icon.png"
    },
    "win": {
      "icon": "public/app_icon.png"
    },
    "linux": {
      "icon": "public/app_icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    },
    "files": [
      "main.js",
      "package.json",
      "app-build/**/*",
      "public/**/*"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.21",
    "@angular/common": "^19.2.21",
    "@angular/compiler": "^19.2.21",
    "@angular/core": "^19.2.21",
    "@angular/forms": "^19.2.21",
    "@angular/platform-browser": "^19.2.21",
    "@angular/platform-browser-dynamic": "^19.2.21",
    "@angular/router": "^19.2.21",
    "@ngrx/operators": "^18.1.1",
    "@ngrx/signals": "^18.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.25",
    "@angular/cli": "^19.2.25",
    "@angular/compiler-cli": "^19.2.21",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.5.0",
    "cheerio": "^1.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.5.2",
    "wait-on": "^9.0.10"
  }
}
